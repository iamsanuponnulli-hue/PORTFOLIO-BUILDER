rules_version = '2';

// Each user may only touch files under users/{their uid}/.
// Keep limits in sync with packages/schema/src/limits.ts.
service firebase.storage {
  match /b/{bucket}/o {
    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/projects/{pid}/assets/{file} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif|svg\\+xml|x-icon)');
    }

    match /users/{uid}/projects/{pid}/resume/{file} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /users/{uid}/projects/{pid}/versions/{file} {
      allow read, delete: if isUser(uid);
      // Snapshots are write-once: no existing object may be replaced.
      allow create: if isUser(uid)
        && resource == null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'application/json';
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

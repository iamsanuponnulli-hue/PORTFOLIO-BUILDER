{
  "name": "@pb/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser bundle exposed to Flutter as window.pb, plus the background worker.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
